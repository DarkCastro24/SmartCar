# Copia este archivo como .env y completa los valores.
# .env está en .gitignore: nunca lo subas a GitHub.

# Base de datos. Ejemplos:
#   PostgreSQL local:  postgresql://postgres:tu_clave@localhost:5432/smartcar
#   Neon / Supabase:   postgresql://usuario:clave@host/smartcar?sslmode=require
# Si la dejas vacía se usa SQLite (instance/smartcar.db), útil solo para pruebas rápidas.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartcar

# Clave para firmar los tokens JWT. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Horas que dura la sesión antes de pedir login otra vez (168 = 7 días)
JWT_EXPIRES_HOURS=168

# Client ID de Google Cloud Console (credencial OAuth tipo "Aplicación web")
GOOGLE_CLIENT_ID=123456789-xxxxxxxxxxxx.apps.googleusercontent.com

# URL(s) del frontend que pueden llamar a la API, separadas por comas
FRONTEND_URL=http://localhost:5173
